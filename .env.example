# TypeSafe AI (jev classifier): https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Fireworks AI (ember-1 vision descriptions for the indexer)
FIREWORKS_API_KEY=
VISION_LLM_MODEL=accounts/fireworks/models/ember-1
# Slack app (see slack_app_manifest.json)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional: pick a different index, e.g. a full local library
# WOJAK_INDEX=wojak_index.full.json
# Optional: Logfire tracing (https://logfire.pydantic.dev). Surrounding
# quotes are stripped like docker compose does; unquoted is preferred.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://logfire-us.pydantic.dev
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=pylf_v1_us_...
